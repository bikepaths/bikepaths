[DEFAULT]
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
port = 2323
logpath = %(sshd_log)s
backend = %(sshd_backend)s

[apache-auth]
enabled = true
maxretry = 3
findtime = 60m

[apache-badbots]
enabled = true
maxretry = 2
bantime = 24h
findtime = 60m

[apache-noscript]
enabled = true
maxretry = 3

[apache-overflows]
enabled = true
maxretry = 2

[apache-404]
enabled = true
port = http,https
filter = apache-404
logpath = /var/log/apache2/*access.log
maxretry = 3
findtime = 60m
bantime = 24h

[apache-dos]
enabled  = true
port     = http,https
filter   = apache-dos
logpath  = /var/log/apache2/bikepaths_access.log
maxretry = 150
findtime = 2m
bantime  = 6h
ignoreip = 127.0.0.1/8 ::1
           66.249.64.0/19 66.249.80.0/20
           157.55.39.0/24 207.46.13.0/24
           17.0.0.0/8
