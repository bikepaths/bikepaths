        .pagination a:hover { background: #e9ecef; }
        .pagination .current { background: #007cba; color: white; border-color: #007cba; }

        /* Lightbox */
        .lightbox { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 2000; }
        .lightbox-content { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 95%; height: 90%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
        .lightbox img, .lightbox video { max-width: 100%; max-height: 82%; object-fit: contain; border-radius: 4px; }
        .lightbox iframe { width: 90%; height: 82%; background: white; border: none; border-radius: 8px; }
        .lightbox audio { width: 80%; max-width: 600px; margin-top: 20px; }
        .lightbox-info { color: white; text-align: center; margin-top: 20px; font-size: 15px; background: rgba(0,0,0,0.6); padding: 8px 20px; border-radius: 20px; }
        .close { position: absolute; top: 20px; right: 30px; color: #fff; font-size: 40px; cursor: pointer; z-index: 2001; }
        
        @media (max-width: 768px) {
            .controls { float: none; display: flex; justify-content: center; margin-top: 15px; }
            .gallery.list .fileinfo { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="breadcrumbs">
            <?php echo $this->generateBreadcrumbs($current_dir); ?>
        </div>
        <div class="controls">
            <button class="grid-toggle <?php echo $thumb_size == 0 ? 'active' : ''; ?>" onclick="changeGridSize(0)">List</button>
            <button class="grid-toggle <?php echo $thumb_size == 150 ? 'active' : ''; ?>" onclick="changeGridSize(150)">SML</button>
            <button class="grid-toggle <?php echo $thumb_size == 200 ? 'active' : ''; ?>" onclick="changeGridSize(200)">MED</button>
            <button class="grid-toggle <?php echo $thumb_size == 300 ? 'active' : ''; ?>" onclick="changeGridSize(300)">LRG</button>
        </div>
        <div style="clear: both;"></div>
    </div>

    <div class="gallery <?php echo $is_list ? 'list' : ($thumb_size <= 150 ? 'small' : ($thumb_size <= 200 ? 'medium' : 'large')); ?>" id="gallery">
        <?php foreach ($content['dirs'] as $dir): ?>
            <div class="item folder-item" onclick="location.href='?dir=<?php echo urlencode(($current_dir ? $current_dir . '/' : '') . $dir['path']); ?>'">
                <div class="thumb-wrapper">
                    <span class="folder <?php echo $is_list ? '' : 'icon-large'; ?>">📁</span>
                </div>
                <div class="filename"><?php echo htmlspecialchars($dir['name'], ENT_QUOTES, 'UTF-8'); ?></div>
                <div class="fileinfo"><?php echo date('Y-m-d H:i', $dir['mtime']); ?></div>
            </div>
        <?php endforeach; ?>

        <?php foreach ($files_page as $index => $file):
            $full_path = ($current_dir ? $current_dir . '/' : '') . $file['path'];
        ?>
            <div class="item file-item" data-type="<?php echo htmlspecialchars($file['type'], ENT_QUOTES, 'UTF-8'); ?>" onclick="showLightbox(<?php echo (int)$index; ?>)">
                <div class="thumb-wrapper">
                    <?php if ($is_list): ?>
                        <span class="icon-display"><?php echo $file['icon']; ?></span>
                    <?php elseif ($file['type'] === 'youtube'): ?>
                        <img src="https://img.youtube.com/vi/<?php echo htmlspecialchars($file['yt_id'], ENT_QUOTES, 'UTF-8'); ?>/hqdefault.jpg" class="thumb" alt="<?php echo htmlspecialchars($file['name'], ENT_QUOTES, 'UTF-8'); ?>" loading="lazy">
                    <?php elseif ($file['type'] === 'image'): ?>
                        <img src="?thumb=<?php echo urlencode($full_path); ?>&size=<?php echo (int)$thumb_size; ?>" class="thumb" alt="<?php echo htmlspecialchars($file['name'], ENT_QUOTES, 'UTF-8'); ?>" loading="lazy">
                    <?php else: ?>
                        <div class="thumb-badge">
                            <span class="badge-icon"><?php echo $file['icon']; ?></span>
                            <span class="badge-ext"><?php echo htmlspecialchars(strtoupper(pathinfo($file['name'], PATHINFO_EXTENSION)), ENT_QUOTES, 'UTF-8'); ?></span>
                        </div>
                    <?php endif; ?>
                </div>
                <div class="filename"><?php echo htmlspecialchars($file['name'], ENT_QUOTES, 'UTF-8'); ?></div>
                <div class="fileinfo">
                    <?php echo date('Y-m-d H:i', $file['mtime']); ?> • <?php echo number_format($file['size'] / 1024, 1); ?> KB
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if ($total_pages > 1): ?>
        <div class="pagination">
            <?php for ($i = 1; $i <= $total_pages; $i++): ?>
                <?php if ($i == $page): ?>
                    <span class="current"><?php echo $i; ?></span>
                <?php else: ?>
                    <a href="?dir=<?php echo urlencode($current_dir); ?>&page=<?php echo $i; ?>&size=<?php echo (int)$thumb_size; ?>"><?php echo $i; ?></a>
                <?php endif; ?>
            <?php endfor; ?>
        </div>
    <?php endif; ?>

    <div class="lightbox" id="lightbox">
        <span class="close" onclick="hideLightbox()">&times;</span>
        <div class="lightbox-content" id="lightbox-content"></div>
    </div>

    <script>
        let currentFileIndex = 0;
        const files = <?php echo json_encode(array_values($files_page), JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
        const currentDir = <?php echo json_encode($current_dir, JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;
        const webRoot = <?php echo json_encode($this->config['web_root'], JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP); ?>;

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function changeGridSize(size) {
            const url = new URL(window.location);
            url.searchParams.set('size', size);
            window.location.href = url.toString();
        }

        function showLightbox(index) {
            currentFileIndex = index;
            const file = files[index];
            if (!file) return;

            const filePath = (currentDir ? currentDir + '/' : '') + file.path;
            const fullUrl = webRoot + '/' + encodeURI(filePath);
            const contentDiv = document.getElementById('lightbox-content');
            
            let html = '';
            if (file.type === 'image') {
                html = `<img src="${fullUrl}" alt="${escapeHtml(file.name)}">`;
            } else if (file.type === 'youtube') {
                html = `<iframe src="https://www.youtube-nocookie.com/embed/${encodeURIComponent(file.yt_id)}?modestbranding=1&rel=0&showinfo=0&autoplay=1" frameborder="0" allowfullscreen style="width:100%; height:480px;"></iframe>`;
            } else if (file.type === 'video') {
                html = `<video src="${fullUrl}" controls autoplay></video>`;
            } else if (file.type === 'audio') {
                html = `<div style="font-size: 64px">📻</div><br><audio src="${fullUrl}" controls autoplay style="width:100%"></audio>`;
            } else if (file.type === 'doc') {
                html = `<iframe src="${fullUrl}" style="width:100%; height:480px; background:white;"></iframe><br><a href="${fullUrl}" target="_blank" style="color:#007cba; background:white; padding:6px 16px; border-radius:15px; text-decoration:none; margin-top:12px; display:inline-block; font-weight:500;">Open Document in New Tab</a>`;
            } else {
                html = `<div style="font-size: 64px">📄</div><br><a href="${fullUrl}" target="_blank" style="color:white; text-decoration:none; border:1px solid #555; padding:10px 20px; border-radius:5px">Download ${escapeHtml(file.name)}</a>`;
            }

            html += `<div class="lightbox-info">
                <strong>${escapeHtml(file.name)}</strong><br>
                ${new Date(file.mtime * 1000).toLocaleString()} • ${(file.size / 1024).toFixed(1)} KB
            </div>`;

            contentDiv.innerHTML = html;
            document.getElementById('lightbox').style.display = 'block';
        }

        function hideLightbox() {
            document.getElementById('lightbox').style.display = 'none';
            document.getElementById('lightbox-content').innerHTML = '';
        }

        document.addEventListener('keydown', function(e) {
            if (document.getElementById('lightbox').style.display === 'block') {
                if (e.key === 'Escape') hideLightbox();
                if (e.key === 'ArrowRight' && currentFileIndex < files.length - 1) showLightbox(currentFileIndex + 1);
                if (e.key === 'ArrowLeft' && currentFileIndex > 0) showLightbox(currentFileIndex - 1);
            }
        });

        document.getElementById('lightbox').addEventListener('click', function(e) {
            if (e.target === this) hideLightbox();
        });
    </script>
</body>
</html>
<?php 
        return ob_get_clean(); 
    } 
}

class Gallery {
    private $config;
    private $fileManager;
    private $imageProcessor;
    private $uiRenderer;

    public function __construct($config) {
        $this->config = $config;
        $this->fileManager = new FileManager($config);
        $this->imageProcessor = new ImageProcessor($config);
        $this->uiRenderer = new UIRenderer($config);
    }

    public function handleRequest() {
        if (isset($_GET['thumb'])) {
            $raw_thumb = (string)$_GET['thumb'];
            $clean_thumb = str_replace(["␀", '../', '..\'], '', $raw_thumb);
            $clean_thumb = ltrim($clean_thumb, '/\');
            
            $size = isset($_GET['size']) ? intval($_GET['size']) : $this->config['default_thumb_size'];
            if (!in_array($size, $this->config['thumb_sizes'])) {
                $size = $this->config['default_thumb_size'];
            }
            $this->imageProcessor->generateThumbnail($clean_thumb, $size);
            return;
        }

        $current_dir = isset($_GET['dir']) ? str_replace(["␀", '../', '..\'], '', (string)$_GET['dir']) : '';
        $current_dir = trim($current_dir, '/\');

        $real_root = realpath($this->config['gallery_root']);
        $full_path = realpath($this->config['gallery_root'] . ($current_dir ? '/' . $current_dir : ''));

        if (!$full_path || strpos($full_path, $real_root) !== 0 || !is_dir($full_path)) {
            $current_dir = '';
            $full_path = $real_root;
        }

        $content = $this->fileManager->scanDirectory($full_path);
        $page = isset($_GET['page']) ? max(1, intval($_GET['page'])) : 1;
        $total_files = count($content['files']);
        $total_pages = max(1, ceil($total_files / $this->config['per_page']));
        
        $thumb_size = isset($_GET['size']) ? intval($_GET['size']) : $this->config['default_thumb_size'];
        if (!in_array($thumb_size, $this->config['thumb_sizes'])) {
            $thumb_size = $this->config['default_thumb_size'];
        }

        echo $this->uiRenderer->renderHTML($content, $current_dir, $page, $total_pages, $thumb_size);
    }
}

$gallery = new Gallery($config);
$gallery->handleRequest();
